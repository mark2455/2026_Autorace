<?xml version="1.0"?>
<package format="3">
  <name>autorace_ros2_compat</name>
  <version>0.1.0</version>
  <description>Small ROS1-source compatibility shim backed by ROS 2 rclcpp for the AutoRace migration.</description>
  <maintainer email="maintainer@example.com">AutoRace migration</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>tf2</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
