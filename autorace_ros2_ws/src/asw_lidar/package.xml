<?xml version="1.0"?>
<package format="3">
  <name>asw_lidar</name>
  <version>0.1.0</version>
  <description>ROS 2 migration of the 2024 AutoRace LiDAR mission node.</description>
  <maintainer email="maintainer@example.com">AutoRace migration</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>autorace_ros2_compat</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>coss_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>laser_geometry</depend>
  <depend>cv_bridge</depend>
  <member_of_group>rosidl_interface_packages</member_of_group>
  <export><build_type>ament_cmake</build_type></export>
</package>
